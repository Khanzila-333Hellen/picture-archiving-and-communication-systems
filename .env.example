# PACS Application Environment Configuration
# Copy this file to .env and update the values for your environment

# Backend API Configuration
BACKEND_API_BASE_URL=http://localhost/PictureProject/website/backend/api
FRONTEND_BASE_URL=http://localhost/PictureProject/website/frontend

# React Native App Configuration
REACT_APP_API_BASE_URL=http://localhost/PictureProject/website/backend/api
REACT_APP_VERSION=1.0.0

# Database Configuration (Used by PHP backend)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=picture_db

# JWT Secret Key (Change this in production!)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=3600

# Application Settings
APP_ENV=development
APP_DEBUG=true

# File Upload Settings
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,dcm,pdf

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8081,http://localhost,http://localhost/PictureProject
